PORT=8000
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/track
SESSION_SECRET=change-me-to-random-secret-in-production
UPLOADS_DIR=uploads
# Необязательно: укажите LAN-адрес вручную, если автоопределение выбрало VPN.
# Например: http://192.168.1.42:5173
APP_BASE_URL=
FRONTEND_PORT=5173

# Интеграция с локальным Streamer.bot (Twitch без собственного Client ID).
STREAMERBOT_ENABLED=false
STREAMERBOT_WS_URL=ws://127.0.0.1:8080/
# Должен совпадать с паролем WebSocket Server в Streamer.bot. Можно оставить
# пустым, если аутентификация сервера выключена.
STREAMERBOT_PASSWORD=
# Укажите ID комнаты ИЛИ её шестизначный код приглашения.
STREAMERBOT_ROOM_ID=
STREAMERBOT_ROOM_CODE=
STREAMERBOT_COMMAND_PREFIX=!
